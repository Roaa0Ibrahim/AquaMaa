topic: ~water_keywords()

# Keyword listening (15 Nov, final): any sentence containing one of these words picks a TOPIC. Pepper sends only the
# topic name and its mode (officer or farmer) to the laptop; what to say or ask for each topic is in
# fresh-start/pepper_topics.json on the laptop, so it can change there without updating Pepper.
# Order matters: the first rule that matches wins, so specific topics come before general ones.
# If Pepper can't load this file, the app falls back to water_quality.top (exact sentences).

concept:(hello) [hello hi hey "good morning" "good afternoon" "good evening" salam]
concept:(bye) [thanks "thank you" bye goodbye]

u:({*} ~hello {*}) ^execute(ask, hello)

u:({*} ~bye {*}) ^execute(ask, bye)

u:({*} [report briefing summary overview] {*}) Let me prepare the report. ^execute(ask, report)

u:({*} [licence license permit penalty fine law legal illegal] {*}) Let me check the law. ^execute(ask, law)

u:({*} [municipality municipalities region regions area areas] {*}) Let me check the national data. ^execute(ask, municipality)

u:({*} [index] {*}) Let me check the water quality index. ^execute(ask, index)

u:({*} [offline connected working disconnected] {*}) Let me check the sensors. ^execute(ask, offline)

u:({*} [attention problem problems wrong alert alerts warning] {*}) Let me check the alerts. ^execute(ask, attention)

u:({*} [test testing measure measuring] {*}) Good question. ^execute(ask, test)

u:({*} [saltier rising increasing worse trend changing] {*}) Let me look at the recent readings. ^execute(ask, trend)

u:({*} [temperature temperatures hot cold warm degrees] {*}) Let me check the sensor. ^execute(ask, temperature)

u:({*} [pH "P H" acid acidic acidity alkaline alkalinity] {*}) Let me check the sensor. ^execute(ask, ph)

u:({*} [drink drinking drinkable potable] {*}) Let me check the sensor. ^execute(ask, drink)

u:({*} [crops crop grow growing plant plants vegetables tomatoes] {*}) Let me check which crops suit this water. ^execute(ask, crops)

u:({*} [palms palm dates irrigate irrigation irrigating] {*}) Let me check what this water is good for. ^execute(ask, irrigation)

u:({*} [do recommend recommendation advice should] {*}) Let me think about it. ^execute(ask, advice)

u:({*} [dashboard screen page show] {*}) Let me read the page. ^execute(ask, dashboard)

u:({*} [salt salty saltiness salinity TDS "T D S" quality reading readings sensor water wells well] {*}) Let me check the sensor. ^execute(ask, salinity)
