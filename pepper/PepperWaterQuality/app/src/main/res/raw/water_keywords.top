topic: ~water_keywords()

# Keyword listening (14 Nov): any sentence that contains one of these words triggers the question, so people can
# speak naturally ("Pepper, how salty is our water today?"). {*} = any words before or after. The answer always
# comes live from AquaMaa (^execute(ask, ...)), never from this file.
# If Pepper can't load this file, the app falls back to water_quality.top (exact sentences).

concept:(hello) [hello hi hey "good morning" "good afternoon" "good evening" salam]
concept:(bye) [thanks "thank you" bye goodbye]

u:({*} ~hello {*}) Hello! I am AquaMaa. I watch the wells. Ask me about the salt in the water, drinking, irrigation, or the alerts.

u:({*} [drink drinking drinkable potable] {*}) Let me check the sensor. ^execute(ask, Is the water right now suitable for drinking)

u:({*} [irrigate irrigation irrigating crops crop palms palm dates farm farming tomatoes plants] {*}) Let me check what this water is good for. ^execute(ask, Is the water right now suitable for irrigation)

u:({*} [why reason cause] {*}) Good question. ^execute(ask, Why are wells getting saltier)

u:({*} [licence license permit law fine penalty legal] {*}) Let me check the law. ^execute(ask, Do farmers need a licence to dig a new well)

u:({*} [alert alerts problem problems wrong attention offline briefing] {*}) Here is the status of the wells. ^execute(ask, Which sensors need attention and which are offline right now)

u:({*} [dashboard screen page show] {*}) Let me read the dashboard. ^execute(ask, What does the dashboard show right now)

u:({*} [temperature temperatures hot cold warm degrees] {*}) Let me check the sensor. ^execute(ask, What is the water temperature right now and what does it mean)

u:({*} [pH "P H" acid acidic acidity alkaline alkalinity] {*}) Let me check the sensor. ^execute(ask, What is the pH of the water right now and what does it mean)

u:({*} [readings values everything "all the" status situation] {*}) Let me read all the sensors. ^execute(ask, What are the current sensor readings and what do they mean)

u:({*} [trend saltier rising increasing worse changing] {*}) Let me look at the recent readings. ^execute(ask, Is the water getting saltier)

u:({*} [salt salty saltiness salinity TDS "T D S" quality reading sensor water] {*}) Let me check the sensor. ^execute(ask, What is the salinity of the water right now)

u:({*} ~bye {*}) You are welcome! I will keep watching the wells. Goodbye!
