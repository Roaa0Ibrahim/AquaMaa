<?xml version="1.0" encoding="utf-8"?>
<!-- Pepper's tablet: the live AquaNova dashboard fills the screen; one compact strip below shows what Pepper heard and
     what it is saying (answers and alerts), and its state at the end (14 Nov: use the full height). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B3D5C"
    android:orientation="vertical">

    <WebView
        android:id="@+id/dashboard"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#0B3D5C"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="16dp"
        android:paddingTop="4dp"
        android:paddingRight="16dp"
        android:paddingBottom="4dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/heard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="Ask me: What is the salinity now? · Is it good for irrigation? · Is the water safe to drink?"
                android:textColor="#A5D6A7"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/answer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="2"
                android:ellipsize="end"
                android:text="AquaMaa: I watch the wells for you"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"
            android:maxWidth="260dp"
            android:maxLines="2"
            android:ellipsize="end"
            android:text="Starting..."
            android:textColor="#FFD54F"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
